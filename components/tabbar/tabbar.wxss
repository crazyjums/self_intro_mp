.sub-tabbar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 50; display: flex; align-items: center; height: 104rpx; padding-bottom: 10rpx; border-top: 1rpx solid rgba(0,0,0,.06); background: rgba(255,255,255,.98); box-shadow: 0 -8rpx 28rpx rgba(29,29,31,.04); }
.sub-tab { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; color: #8E8E93; font-size: 17rpx; }
.sub-tab image { width: 34rpx; height: 34rpx; margin-bottom: 5rpx; opacity: .76; }
.sub-tab.active { color: #10B981; font-weight: 600; }
.sub-tab.active image { opacity: 1; }
