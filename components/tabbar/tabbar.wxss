.sub-tabbar { position: fixed; right: 20rpx; bottom: 28rpx; left: 20rpx; z-index: 50; display: flex; align-items: center; height: 104rpx; padding-bottom: 8rpx; border: 1rpx solid rgba(116, 255, 188, .3); border-radius: 54rpx; background: rgba(6, 24, 25, .96); box-shadow: 0 14rpx 44rpx rgba(0,0,0,.5), inset 0 1rpx 0 rgba(255,255,255,.08); }
.sub-tab { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-height: 76rpx; margin: 8rpx 3rpx; border-radius: 36rpx; color: #91A29E; font-size: 17rpx; transition: all .2s ease; }
.sub-tab image { width: 34rpx; height: 34rpx; margin-bottom: 5rpx; opacity: .72; }
.sub-tab.active { color: #55F6A7; background: radial-gradient(circle at 50% 24%, rgba(67,245,154,.24), rgba(67,245,154,.05) 70%); box-shadow: inset 0 1rpx 0 rgba(148,255,203,.24), 0 0 24rpx rgba(67,245,154,.12); font-weight: 600; }
.sub-tab.active image { opacity: 1; filter: drop-shadow(0 0 8rpx rgba(67,245,154,.65)); }
