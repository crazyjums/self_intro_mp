<view class="sub-tabbar">
  <view class="sub-tab {{active === 'home' ? 'active' : ''}}" data-url="/pages/index/index" bindtap="switchTab">
    <image src="{{active === 'home' ? '/images/tab-home-active.png' : '/images/tab-home.png'}}" />
    <text>首页</text>
  </view>
  <view class="sub-tab {{active === 'skills' ? 'active' : ''}}" data-url="/pages/skills/skills" bindtap="switchTab">
    <image src="{{active === 'skills' ? '/images/tab-pulse-active.png' : '/images/tab-pulse.png'}}" />
    <text>技能</text>
  </view>
  <view class="sub-tab {{active === 'projects' ? 'active' : ''}}" data-url="/pages/projects/projects" bindtap="switchTab">
    <image src="{{active === 'projects' ? '/images/tab-briefcase-active.png' : '/images/tab-briefcase.png'}}" />
    <text>项目</text>
  </view>
  <view class="sub-tab {{active === 'ai' ? 'active' : ''}}" data-url="/pages/ai-assistant/ai-assistant" bindtap="switchTab">
    <image src="{{active === 'ai' ? '/images/tab-ai-active.png' : '/images/tab-ai.png'}}" />
    <text>AI助手</text>
  </view>
  <view class="sub-tab {{active === 'profile' ? 'active' : ''}}" data-url="/pages/profile/profile" bindtap="switchTab">
    <image src="{{active === 'profile' ? '/images/tab-user-active.png' : '/images/tab-user.png'}}" />
    <text>我的</text>
  </view>
</view>
