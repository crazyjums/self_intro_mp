page {
  --accent: #43F59A;
  --accent-dark: #20C879;
  --accent-soft: rgba(67, 245, 154, 0.13);
  --ink: #F2FBF7;
  --ink-2: #C8D9D3;
  --ink-3: #8BA29B;
  --ink-4: #627771;
  --line: rgba(164, 221, 195, 0.16);
  --surface: rgba(8, 29, 30, 0.9);
  --bg: #02090D;
  --radius: 28rpx;
  --radius-sm: 16rpx;
  --shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.28);

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display",
    "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 20rpx 24rpx 48rpx;
}

.tabbar-page {
  padding-bottom: 150rpx;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 4rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--ink);
}

.section-link {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 500;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
}

.page-header-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.header-action {
  width: 56rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  text-align: center;
}

.header-action.placeholder {
  opacity: 0;
}

/* ---- entrance animation ---- */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim {
  opacity: 0;
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

/* ---- text helpers ---- */
.muted { color: var(--ink-3); }
.small { font-size: 24rpx; }
.caption { font-size: 22rpx; color: var(--ink-4); }

/* ---- buttons ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary {
  background: var(--accent);
  color: #022315;
  box-shadow: 0 12rpx 32rpx rgba(67, 245, 154, 0.24);
}

.btn-ghost {
  background: var(--surface);
  color: var(--ink);
  border: 1rpx solid var(--line);
}

/* ---- tags ---- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 500;
}

.tag-gray {
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid var(--line);
}

.press { opacity: 0.75; transform: scale(0.985); }

.text-green { color: var(--accent); }
