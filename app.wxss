page {
  --accent: #10B981;
  --accent-dark: #0D9668;
  --accent-soft: #E7F8F1;
  --ink: #1D1D1F;
  --ink-2: #3A3A3C;
  --ink-3: #8E8E93;
  --ink-4: #AEAEB2;
  --line: #E5E5EA;
  --surface: #FFFFFF;
  --bg: #F7F8FA;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --shadow: 0 8rpx 32rpx rgba(29, 29, 31, 0.06);

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display",
    "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 20rpx 24rpx 48rpx;
}

.tabbar-page {
  padding-bottom: 150rpx;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 4rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--ink);
}

.section-link {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 500;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
}

.page-header-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.header-action {
  width: 56rpx;
  color: var(--ink-3);
  font-size: 30rpx;
  text-align: center;
}

.header-action.placeholder {
  opacity: 0;
}

/* ---- entrance animation ---- */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim {
  opacity: 0;
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

/* ---- text helpers ---- */
.muted { color: var(--ink-3); }
.small { font-size: 24rpx; }
.caption { font-size: 22rpx; color: var(--ink-4); }

/* ---- buttons ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary {
  background: var(--accent);
  color: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(16, 185, 129, 0.32);
}

.btn-ghost {
  background: var(--surface);
  color: var(--ink);
  border: 1rpx solid var(--line);
}

/* ---- tags ---- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--accent-soft);
  color: var(--accent-dark);
  font-weight: 500;
}

.tag-gray {
  color: var(--ink-2);
  background: #F3F4F6;
  border: 1rpx solid #ECEEF1;
}

.press { opacity: 0.75; transform: scale(0.985); }

.text-green { color: var(--accent); }
