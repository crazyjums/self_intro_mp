.info-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDF2F7;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex-shrink: 0;
  font-size: 26rpx;
}

.info-value {
  text-align: right;
  font-size: 28rpx;
  color: #2D3748;
}

.skill-group {
  margin-bottom: 24rpx;
}

.skill-group:last-child {
  margin-bottom: 0;
}

.skill-group-title {
  font-size: 26rpx;
  color: #2B6CB0;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.skill-item {
  margin-bottom: 20rpx;
}

.skill-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.skill-name {
  font-size: 28rpx;
}

.skill-level {
  font-size: 24rpx;
}

.skill-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: #EDF2F7;
  overflow: hidden;
}

.skill-bar-inner {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #2B6CB0, #4299E1);
}
