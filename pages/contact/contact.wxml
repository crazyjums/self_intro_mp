<view class="page">
  <view class="contact-hero card">
    <view class="contact-hero-name">保持联系</view>
    <view class="contact-hero-sub muted">技术交流、合作机会，欢迎随时找我</view>
  </view>

  <view class="card contact-list">
    <view class="contact-row" wx:for="{{contacts}}" wx:key="type"
      data-value="{{item.value}}" bindtap="copy" hover-class="press">
      <view class="contact-icon">{{item.icon}}</view>
      <view class="contact-info">
        <view class="contact-label muted">{{item.label}}</view>
        <view class="contact-value">{{item.value}}</view>
      </view>
      <view class="contact-copy">复制</view>
    </view>
  </view>

  <view class="card qr-card">
    <view class="qr-title">扫码加我微信</view>
    <view class="qr-wrap" bindtap="previewQr" hover-class="press">
      <image class="qr-img" src="/images/wechat.jpg" mode="aspectFit" />
      <view class="qr-tip">点击放大二维码</view>
    </view>
    <view class="qr-hint muted">提示：微信个人二维码可能无法长按识别，可复制微信号搜索添加</view>
  </view>

  <view class="btn btn-primary action" bindtap="saveContact">保存联系方式</view>
  <view class="btn btn-ghost action" bindtap="goPoster">生成我的简历海报</view>
</view>
