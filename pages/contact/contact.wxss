.contact-hero {
  text-align: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(135deg, #FFFFFF, #F0FDF8);
}

.contact-hero-name {
  font-size: 44rpx;
  font-weight: 800;
}

.contact-hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.contact-list {
  padding: 8rpx 40rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--line);
  transition: transform 0.15s ease;
}

.contact-row:last-child {
  border-bottom: none;
}

.press {
  transform: scale(0.98);
}

.contact-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 22rpx;
}

.contact-value {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.contact-copy {
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 999rpx;
}

.action {
  margin-top: 28rpx;
}

.qr-card {
  text-align: center;
}

.qr-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.qr-wrap {
  display: inline-block;
  padding: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  transition: transform 0.15s ease;
}

.qr-img {
  width: 280rpx;
  height: 280rpx;
}

.qr-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--accent);
}

.qr-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
