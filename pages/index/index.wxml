<view class="page">
  <view class="hero">
    <image class="avatar" src="{{profile.avatar}}" mode="aspectFill" />
    <view class="hero-name">{{profile.name}}</view>
    <view class="hero-en">{{profile.enName}}</view>
    <view class="hero-title">{{profile.title}}</view>
    <view class="hero-slogan">{{profile.slogan}}</view>
  </view>

  <view class="card">
    <view class="card-title">求职意向</view>
    <view class="intention-grid">
      <view class="intention-item">
        <view class="intention-label label">岗位</view>
        <view class="intention-value">{{profile.jobIntention.position}}</view>
      </view>
      <view class="intention-item">
        <view class="intention-label label">城市</view>
        <view class="intention-value">{{profile.jobIntention.city}}</view>
      </view>
      <view class="intention-item">
        <view class="intention-label label">经验</view>
        <view class="intention-value">{{profile.jobIntention.experience}}</view>
      </view>
      <view class="intention-item">
        <view class="intention-label label">学历</view>
        <view class="intention-value">{{profile.jobIntention.education}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">个人简介</view>
    <view class="summary">{{profile.summary}}</view>
  </view>

  <view class="card">
    <view class="card-title">个性签名</view>
    <view class="quotes">
      <view class="quote-item" wx:for="{{profile.quotes}}" wx:key="*this">
        <view class="quote-mark">“</view>
        <view class="quote-text">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="footer-nav">
    <view class="footer-btn" bindtap="goAbout">查看关于我</view>
    <view class="footer-btn" bindtap="goExperience">查看经历项目</view>
  </view>
</view>
