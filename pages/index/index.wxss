.home-page {
  position: relative;
  padding: 24rpx 24rpx 170rpx;
  overflow: hidden;
}

.hero-card {
  position: relative;
  overflow: hidden;
  min-height: 564rpx;
  border: 1rpx solid rgba(126, 255, 195, .26);
  border-radius: 32rpx;
  background: #031116;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, .38), inset 0 1rpx 0 rgba(255,255,255,.08);
  color: #FFFFFF;
}

.hero-bg,
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-bg { opacity: .58; transform: scale(1.08); }

.hero-shade { background: linear-gradient(120deg, rgba(1,10,13,.92), rgba(2,14,18,.46) 58%, rgba(2,20,17,.24)); }

.hero-content {
  position: relative;
  z-index: 1;
  padding: 30rpx 28rpx 32rpx;
}

.hero-topline {
  display: flex;
  align-items: center;
  width: fit-content;
  padding: 9rpx 18rpx;
  border: 1rpx solid rgba(115,255,191,.3);
  border-radius: 999rpx;
  background: rgba(6,35,30,.5);
  color: #B6F5D1;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.online-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #34D399;
  box-shadow: 0 0 0 6rpx rgba(52,211,153,.12);
}

.identity-row {
  display: flex;
  align-items: center;
  margin-top: 58rpx;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  border: 5rpx solid rgba(176,255,214,.9);
  border-radius: 50%;
  background: #DDE7EA;
  box-shadow: 0 0 0 12rpx rgba(67,245,154,.12), 0 0 34rpx rgba(67,245,154,.34);
}

.identity-copy { flex: 1; min-width: 0; margin-left: 26rpx; }

.hero-name {
  font-size: 50rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-en {
  margin-top: 3rpx;
  color: rgba(214,255,232,.68);
  font-size: 21rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.hero-role {
  margin-top: 16rpx;
  color: #65F5AA;
  font-size: 24rpx;
  font-weight: 600;
}

.hero-subtitle {
  margin-top: 3rpx;
  color: rgba(255,255,255,.6);
  font-size: 20rpx;
}

.hero-slogan {
  margin-top: 40rpx;
  max-width: 560rpx;
  color: rgba(235,255,247,.86);
  font-size: 25rpx;
  line-height: 1.65;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.dark-tag {
  margin: 0 10rpx 10rpx 0;
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(121,255,190,.23);
  border-radius: 999rpx;
  background: rgba(5, 35, 30, .62);
  color: #C8FFE0;
  font-size: 20rpx;
}

.metric-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: -30rpx 16rpx 0;
  padding: 26rpx 12rpx;
  border: 1rpx solid rgba(121,255,190,.22);
  border-radius: 24rpx;
  background: rgba(5, 24, 25, .96);
  box-shadow: 0 16rpx 42rpx rgba(0,0,0,.34);
  z-index: 2;
}

.metric { flex: 1; text-align: center; }
.metric + .metric { border-left: 1rpx solid rgba(168,232,200,.2); }
.metric-value { color: #65F6AD; font-size: 34rpx; font-weight: 800; }
.metric-label { margin-top: 4rpx; color: #94AAA3; font-size: 18rpx; }

.section-head { padding: 40rpx 4rpx 20rpx; }
.section-title { padding-left: 14rpx; border-left: 6rpx solid var(--accent); font-size: 32rpx; }

.project-list { overflow: hidden; }

.home-project {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(146,255,202,.18);
  border-radius: 24rpx;
  background: linear-gradient(120deg, rgba(10,37,38,.96), rgba(5,21,24,.94));
  box-shadow: 0 12rpx 34rpx rgba(0,0,0,.24), inset 0 1rpx 0 rgba(255,255,255,.05);
}

.home-project:last-child { margin-bottom: 0; }

.project-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(109,255,183,.38);
  border-radius: 22rpx;
  color: #70F7B3;
  font-size: 30rpx;
  font-weight: 800;
}

.project-icon-1, .project-icon-2, .project-icon-3 { background: radial-gradient(circle at 30% 20%, rgba(92,255,167,.34), rgba(6,48,40,.76)); box-shadow: inset 0 1rpx 0 rgba(187,255,217,.3), 0 0 24rpx rgba(67,245,154,.16); }
.home-project-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.home-project-title { color: #F4FFF9; font-size: 28rpx; font-weight: 700; }
.home-project-desc { margin-top: 7rpx; color: #A5BBB4; font-size: 20rpx; line-height: 1.45; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-project-tags { display: flex; flex-wrap: wrap; margin-top: 7rpx; }
.home-project-tags text { margin-right: 10rpx; padding: 4rpx 10rpx; border: 1rpx solid rgba(125,255,193,.14); border-radius: 8rpx; color: #A9D5C0; font-size: 17rpx; }
.chevron { margin-left: 10rpx; color: #71F5B0; font-size: 34rpx; }

.home-quick-links { margin-top: 22rpx; overflow: hidden; border: 1rpx solid rgba(146,255,202,.16); border-radius: 22rpx; background: rgba(7,29,30,.78); box-shadow: var(--shadow); }
.quick-link { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid rgba(146,255,202,.1); }
.quick-link:last-child { border-bottom: none; }
.quick-link image { width: 32rpx; height: 32rpx; margin-right: 18rpx; }
.quick-link text { color: var(--ink-2); font-size: 26rpx; }
.quick-arrow { margin-left: auto; color: #71F5B0; font-size: 32rpx !important; }

.anim { opacity: 0; }
.anim.show { animation: fadeUp .48s cubic-bezier(.22,1,.36,1) forwards; }
