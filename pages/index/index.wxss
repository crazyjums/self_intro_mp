.home-page {
  padding: 18rpx 24rpx 48rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  min-height: 500rpx;
  border-radius: 28rpx;
  background: #071019;
  box-shadow: 0 16rpx 50rpx rgba(5, 16, 20, .18);
  color: #FFFFFF;
}

.hero-bg,
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-shade { background: rgba(3, 10, 14, .2); }

.hero-content {
  position: relative;
  z-index: 1;
  padding: 30rpx 28rpx 28rpx;
}

.hero-topline {
  display: flex;
  align-items: center;
  color: rgba(255,255,255,.58);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.online-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #34D399;
  box-shadow: 0 0 0 6rpx rgba(52,211,153,.12);
}

.identity-row {
  display: flex;
  align-items: center;
  margin-top: 62rpx;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border: 6rpx solid rgba(255,255,255,.9);
  border-radius: 50%;
  background: #DDE7EA;
  box-shadow: 0 14rpx 40rpx rgba(0,0,0,.24);
}

.identity-copy { margin-left: 24rpx; }

.hero-name {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-en {
  margin-top: 3rpx;
  color: rgba(255,255,255,.72);
  font-size: 21rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.hero-role {
  margin-top: 20rpx;
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 600;
}

.hero-subtitle {
  margin-top: 3rpx;
  color: rgba(255,255,255,.58);
  font-size: 20rpx;
}

.hero-slogan {
  margin-top: 42rpx;
  max-width: 540rpx;
  color: rgba(255,255,255,.82);
  font-size: 24rpx;
  line-height: 1.65;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.dark-tag {
  margin: 0 10rpx 10rpx 0;
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(52,211,153,.18);
  border-radius: 999rpx;
  background: rgba(6, 33, 30, .64);
  color: #B8F9D9;
  font-size: 20rpx;
}

.metric-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: -26rpx 16rpx 0;
  padding: 24rpx 12rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 34rpx rgba(29,29,31,.1);
  z-index: 2;
}

.metric { flex: 1; text-align: center; }
.metric + .metric { border-left: 1rpx solid #E7E9EC; }
.metric-value { color: var(--accent-dark); font-size: 30rpx; font-weight: 800; }
.metric-label { margin-top: 4rpx; color: var(--ink-3); font-size: 18rpx; }

.section-head { padding: 32rpx 2rpx 16rpx; }
.section-title { font-size: 32rpx; }

.project-list { overflow: hidden; border-radius: 22rpx; background: #FFFFFF; box-shadow: var(--shadow); }

.home-project {
  display: flex;
  align-items: center;
  padding: 24rpx 22rpx;
  border-bottom: 1rpx solid #F0F1F2;
}

.home-project:last-child { border-bottom: none; }

.project-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
}

.project-icon-1 { background: #D8F5E8; color: #1A9D6A; }
.project-icon-2 { background: #E6F7F0; color: #1BA06C; }
.project-icon-3 { background: #EAF7F2; color: #22A66D; }
.home-project-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.home-project-title { font-size: 27rpx; font-weight: 700; }
.home-project-desc { margin-top: 5rpx; color: var(--ink-3); font-size: 20rpx; line-height: 1.45; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-project-tags { display: flex; flex-wrap: wrap; margin-top: 7rpx; }
.home-project-tags text { margin-right: 12rpx; color: var(--ink-3); font-size: 18rpx; }
.chevron { margin-left: 10rpx; color: #BCC2C7; font-size: 34rpx; }

.home-quick-links { margin-top: 22rpx; border-radius: 22rpx; background: #FFFFFF; box-shadow: var(--shadow); }
.quick-link { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #F0F1F2; }
.quick-link:last-child { border-bottom: none; }
.quick-link image { width: 32rpx; height: 32rpx; margin-right: 18rpx; }
.quick-link text { font-size: 26rpx; }
.quick-arrow { margin-left: auto; color: #BCC2C7; font-size: 32rpx !important; }

.anim { opacity: 0; }
.anim.show { animation: fadeUp .48s cubic-bezier(.22,1,.36,1) forwards; }
