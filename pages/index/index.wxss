.hero {
  padding: 40rpx 24rpx 8rpx;
  display: flex;
}

.hero-inner {
  flex: 1;
  background: linear-gradient(135deg, #FFFFFF 0%, #F0FDF8 100%);
  border-radius: var(--radius);
  padding: 56rpx 40rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--line);
  text-align: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 0 0 2rpx var(--line), 0 12rpx 32rpx rgba(16, 185, 129, 0.18);
}

.hero-name {
  margin-top: 28rpx;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-en {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.hero-role {
  margin: 24rpx auto 0;
  display: inline-flex;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-dark);
  background: var(--accent-soft);
  border-radius: 999rpx;
}

.hero-line {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.section-title-sm {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin-bottom: 24rpx;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
  background: #F2F2F4;
  border: 1rpx solid var(--line);
  transition: all 0.2s ease;
}

.tag:active {
  background: var(--accent-soft);
  color: var(--accent-dark);
  border-color: var(--accent);
  transform: scale(0.95);
}

/* career */
.career-period {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
}

.career-role {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.career-org {
  margin-top: 4rpx;
  font-size: 26rpx;
}

.career-list {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 20rpx;
}

.career-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* social */
.social-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.social-card {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  margin-bottom: 24rpx;
  background: var(--surface);
  border-radius: var(--radius-sm);
  padding: 32rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
  transition: transform 0.15s ease;
}

.press {
  transform: scale(0.97);
}

.social-icon {
  font-size: 44rpx;
  line-height: 1;
}

.social-name {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.social-value {
  margin-top: 6rpx;
  word-break: break-all;
}

/* articles */
.list-card {
  padding: 12rpx 40rpx;
}

.article-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.article-item:last-child {
  border-bottom: none;
}

.article-info {
  flex: 1;
  padding-right: 20rpx;
}

.article-title {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
}

.article-date {
  margin-top: 6rpx;
}

.article-cat {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: var(--accent-dark);
  background: var(--accent-soft);
  border-radius: 999rpx;
}

.anim {
  opacity: 0;
}

.anim.show {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
