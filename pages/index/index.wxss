.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(160deg, #2B6CB0 0%, #4299E1 100%);
  color: #FFFFFF;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.6);
  background: #FFFFFF;
}

.hero-name {
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.hero-en {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.8;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 20rpx;
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-slogan {
  margin-top: 28rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

.intention-grid {
  display: flex;
  flex-wrap: wrap;
}

.intention-item {
  width: 50%;
  padding: 16rpx 0;
}

.intention-label {
  font-size: 24rpx;
}

.intention-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.summary {
  font-size: 28rpx;
  color: #4A5568;
}

.quote-item {
  position: relative;
  display: flex;
  padding: 12rpx 0 12rpx 52rpx;
}

.quote-mark {
  position: absolute;
  left: 0;
  top: 8rpx;
  font-size: 48rpx;
  color: #2B6CB0;
  font-family: Georgia, serif;
  line-height: 1;
}

.quote-text {
  font-size: 28rpx;
  color: #2D3748;
}

.footer-nav {
  display: flex;
  padding: 24rpx;
}

.footer-btn {
  flex: 1;
  margin: 0 12rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #2B6CB0;
  background: #FFFFFF;
  border: 2rpx solid #2B6CB0;
  border-radius: 999rpx;
}
