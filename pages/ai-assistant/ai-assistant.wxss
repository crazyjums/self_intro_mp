.ai-page { min-height: 100vh; padding-bottom: 120rpx; box-sizing: border-box; background: #F7F8FA; }
.ai-header { display: flex; align-items: center; justify-content: space-between; height: 86rpx; padding: 0 24rpx; background: #FFFFFF; border-bottom: 1rpx solid #F0F1F2; }
.ai-back, .ai-more { width: 52rpx; color: var(--ink); font-size: 42rpx; line-height: 1; }
.ai-more { color: var(--ink-2); font-size: 30rpx; letter-spacing: 4rpx; text-align: right; }
.ai-title { font-size: 34rpx; font-weight: 700; }
.chat-scroll { height: calc(100vh - 350rpx); }
.chat-list { padding: 24rpx; }
.welcome-card { display: flex; align-items: center; padding: 20rpx; border-radius: 18rpx; background: #ECF1F3; }
.welcome-card image { width: 124rpx; height: 124rpx; flex-shrink: 0; }
.welcome-copy { margin-left: 16rpx; }
.welcome-title { font-size: 25rpx; font-weight: 700; }
.welcome-desc { margin-top: 8rpx; color: var(--ink-3); font-size: 19rpx; line-height: 1.5; }
.suggestion-row { display: flex; justify-content: flex-end; margin: 22rpx 0; }
.suggestion { padding: 18rpx 22rpx; border-radius: 18rpx 18rpx 4rpx 18rpx; color: #FFFFFF; background: var(--accent); font-size: 22rpx; }
.message-row { display: flex; margin: 18rpx 0; }
.message-row.user { justify-content: flex-end; }
.message-row.assistant { justify-content: flex-start; }
.message-bubble { max-width: 82%; padding: 20rpx 22rpx; border-radius: 18rpx 18rpx 18rpx 4rpx; color: var(--ink-2); background: #FFFFFF; box-shadow: 0 6rpx 18rpx rgba(0,0,0,.04); font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; }
.message-row.user .message-bubble { border-radius: 18rpx 18rpx 4rpx 18rpx; color: #FFFFFF; background: var(--accent); }
.composer-wrap { display: flex; align-items: center; padding: 18rpx 24rpx 28rpx; background: #FFFFFF; box-shadow: 0 -8rpx 24rpx rgba(0,0,0,.05); }
.composer { flex: 1; height: 74rpx; padding: 0 24rpx; border: 1rpx solid #EEF0F2; border-radius: 999rpx; background: #F8F9FA; color: var(--ink); font-size: 22rpx; }
.send-btn { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin-left: 14rpx; border-radius: 50%; color: #FFFFFF; background: #D6EADF; font-size: 32rpx; }
.send-btn.ready { background: var(--accent); }
