.ai-page { min-height: 100vh; padding-bottom: 120rpx; box-sizing: border-box; background: radial-gradient(circle at 90% 0%, rgba(28,111,80,.24), transparent 30%), #02090D; }
.ai-header { display: flex; align-items: center; justify-content: space-between; height: 86rpx; padding: 0 24rpx; background: rgba(5,22,25,.88); border-bottom: 1rpx solid rgba(143,218,185,.12); }
.ai-back, .ai-more { width: 52rpx; color: var(--ink); font-size: 42rpx; line-height: 1; }
.ai-more { color: var(--ink-2); font-size: 30rpx; letter-spacing: 4rpx; text-align: right; }
.ai-title { font-size: 34rpx; font-weight: 700; }
.chat-scroll { height: calc(100vh - 350rpx); }
.chat-list { padding: 24rpx; }
.welcome-card { display: flex; align-items: center; padding: 20rpx; border: 1rpx solid rgba(116,255,188,.18); border-radius: 22rpx; background: linear-gradient(135deg, rgba(17,55,49,.92), rgba(8,27,31,.92)); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.06); }
.welcome-card image { width: 124rpx; height: 124rpx; flex-shrink: 0; }
.welcome-copy { margin-left: 16rpx; }
.welcome-title { font-size: 25rpx; font-weight: 700; }
.welcome-desc { margin-top: 8rpx; color: #A8BBB6; font-size: 19rpx; line-height: 1.5; }
.suggestion-row { display: flex; justify-content: flex-end; margin: 22rpx 0; }
.suggestion { margin-bottom: 10rpx; padding: 18rpx 22rpx; border-radius: 18rpx 18rpx 4rpx 18rpx; color: #042417; background: var(--accent); box-shadow: 0 8rpx 20rpx rgba(67,245,154,.18); font-size: 22rpx; }
.message-row { display: flex; margin: 18rpx 0; }
.message-row.user { justify-content: flex-end; }
.message-row.assistant { justify-content: flex-start; }
.message-bubble { max-width: 82%; padding: 20rpx 22rpx; border: 1rpx solid rgba(143,218,185,.12); border-radius: 18rpx 18rpx 18rpx 4rpx; color: var(--ink-2); background: rgba(12,38,40,.9); box-shadow: 0 6rpx 18rpx rgba(0,0,0,.14); font-size: 23rpx; line-height: 1.7; white-space: pre-wrap; }
.message-row.user .message-bubble { border-radius: 18rpx 18rpx 4rpx 18rpx; color: #042417; background: var(--accent); }
.composer-wrap { display: flex; align-items: center; padding: 18rpx 24rpx 28rpx; border-top: 1rpx solid rgba(143,218,185,.12); background: rgba(3,14,18,.96); box-shadow: 0 -8rpx 24rpx rgba(0,0,0,.24); }
.composer { flex: 1; height: 74rpx; padding: 0 24rpx; border: 1rpx solid rgba(143,218,185,.18); border-radius: 999rpx; background: rgba(255,255,255,.06); color: var(--ink); font-size: 22rpx; }
.send-btn { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin-left: 14rpx; border-radius: 50%; color: #FFFFFF; background: #1F5942; font-size: 32rpx; }
.send-btn.ready { background: var(--accent); }
