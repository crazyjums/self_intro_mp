.projects-page { padding-top: 12rpx; }
.filter-scroll { width: 100%; white-space: nowrap; }
.filter-row { display: inline-flex; padding: 10rpx 0 24rpx; }
.filter-chip { margin-right: 14rpx; padding: 12rpx 22rpx; border: 1rpx solid rgba(140,229,188,.14); border-radius: 999rpx; color: var(--ink-3); background: rgba(255,255,255,.05); font-size: 22rpx; }
.filter-chip.active { color: #062217; border-color: transparent; background: var(--accent); box-shadow: 0 8rpx 22rpx rgba(67,245,154,.24); }
.project-stack { padding-bottom: 30rpx; }
.project-card { margin-bottom: 22rpx; padding: 28rpx 24rpx; border: 1rpx solid rgba(116,255,188,.16); border-radius: 24rpx; background: linear-gradient(135deg, rgba(12,42,41,.96), rgba(5,21,24,.94)); box-shadow: var(--shadow), inset 0 1rpx 0 rgba(255,255,255,.05); }
.project-card-head { display: flex; align-items: flex-start; justify-content: space-between; }
.project-card-title { flex: 1; padding-right: 16rpx; font-size: 30rpx; font-weight: 700; line-height: 1.35; }
.project-status { flex-shrink: 0; padding: 6rpx 12rpx; border: 1rpx solid rgba(120,255,190,.2); border-radius: 8rpx; color: #70F6AF; background: var(--accent-soft); font-size: 18rpx; }
.project-card-desc { margin-top: 12rpx; color: var(--ink-3); font-size: 22rpx; line-height: 1.55; }
.project-tech { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.project-tech text { margin: 0 10rpx 8rpx 0; padding: 6rpx 12rpx; border: 1rpx solid rgba(143,218,185,.12); border-radius: 7rpx; color: #B9D8CA; background: rgba(255,255,255,.05); font-size: 18rpx; }
.project-meta { display: flex; justify-content: space-between; margin-top: 16rpx; padding-top: 15rpx; border-top: 1rpx solid rgba(143,218,185,.12); color: var(--ink-3); font-size: 18rpx; }
.project-meta text { white-space: nowrap; }
.anim { opacity: 0; animation: fadeUp .48s cubic-bezier(.22,1,.36,1) forwards; }
