<view class="page projects-page tabbar-page">
  <view class="page-header">
    <text class="header-action placeholder">‹</text>
    <text class="page-header-title">项目经验</text>
    <text class="header-action">···</text>
  </view>

  <scroll-view class="filter-scroll" scroll-x="true" show-scrollbar="false">
    <view class="filter-row">
      <view wx:for="{{filters}}" wx:key="*this" wx:for-item="filter"
        class="filter-chip {{activeFilter === filter ? 'active' : ''}}"
        data-filter="{{filter}}" bindtap="selectFilter">{{filter}}</view>
    </view>
  </scroll-view>

  <view class="project-stack">
    <view class="project-card anim show" wx:for="{{visibleProjects}}" wx:key="id"
      data-id="{{item.id}}" bindtap="openDetail" hover-class="press">
      <view class="project-card-head">
        <view class="project-card-title">{{item.name}}</view>
        <view class="project-status">{{item.status}}</view>
      </view>
      <view class="project-card-desc">{{item.intro}}</view>
      <view class="project-tech">
        <text wx:for="{{item.tech}}" wx:for-item="tech" wx:key="*this">{{tech}}</text>
      </view>
      <view class="project-meta">
        <text>◷ {{item.period}}</text>
        <text>♙ {{item.owner}}</text>
        <text>♙ {{item.team}}</text>
      </view>
    </view>
  </view>
  <tabbar active="projects" />
</view>
