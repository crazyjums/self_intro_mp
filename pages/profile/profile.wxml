<view class="page profile-page tabbar-page">
  <view class="page-header">
    <text class="header-action placeholder">‹</text>
    <text class="page-header-title">个人中心</text>
    <text class="header-action">···</text>
  </view>

  <view class="profile-summary">
    <image class="profile-avatar" src="{{profile.avatar}}" mode="aspectFill" />
    <view class="profile-copy">
      <view class="profile-name">{{profile.name}}</view>
      <view class="profile-title">{{profile.shortTitle}}</view>
      <view class="profile-location">⌖ 北京</view>
    </view>
  </view>

  <view class="profile-menu">
    <view class="menu-row" wx:for="{{menuItems}}" wx:key="label" data-type="{{item.type}}" bindtap="openMenu">
      <image src="{{item.icon}}" mode="aspectFit" />
      <text>{{item.label}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="profile-menu secondary-menu">
    <view class="menu-row" bindtap="showPrivacy">
      <text class="menu-symbol">◌</text><text>隐私设置</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="showAbout">
      <text class="menu-symbol">ⓘ</text><text>关于小程序</text><text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="share-btn" bindtap="shareCard">分享我的名片</view>
  <view class="logout" bindtap="logout">退出登录</view>
  <tabbar active="profile" />
</view>
