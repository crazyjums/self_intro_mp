.articles-page { padding-top: 12rpx; padding-bottom: 150rpx; }
.article-filter-scroll { width: 100%; white-space: nowrap; }
.article-filters { display: inline-flex; padding: 12rpx 0 24rpx; }
.article-filter { margin-right: 14rpx; padding: 11rpx 20rpx; border: 1rpx solid rgba(116,255,188,.14); border-radius: 999rpx; color: var(--ink-3); background: rgba(255,255,255,.05); font-size: 22rpx; }
.article-filter.active { color: #042417; border-color: transparent; background: var(--accent); }
.article-list { overflow: hidden; border: 1rpx solid rgba(116,255,188,.14); border-radius: 22rpx; background: rgba(7,28,29,.82); box-shadow: var(--shadow); }
.article-card { display: flex; padding: 22rpx; border-bottom: 1rpx solid rgba(143,218,185,.1); }
.article-card:last-child { border-bottom: none; }
.article-thumb { display: flex; align-items: center; justify-content: center; width: 86rpx; height: 86rpx; flex-shrink: 0; border-radius: 16rpx; color: #FFFFFF; font-size: 25rpx; font-weight: 800; }
.thumb-0 { background: #149966; } .thumb-1 { background: #0D4A41; } .thumb-2 { background: #267A6A; } .thumb-3 { background: #145A57; } .thumb-4 { background: #103C42; }
.article-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.article-title { overflow: hidden; color: var(--ink); font-size: 25rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.article-desc { margin-top: 7rpx; overflow: hidden; color: var(--ink-3); font-size: 19rpx; white-space: nowrap; text-overflow: ellipsis; }
.article-meta { margin-top: 10rpx; color: var(--ink-4); font-size: 18rpx; }
