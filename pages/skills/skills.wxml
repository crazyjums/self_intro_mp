<view class="page skills-page tabbar-page">
  <view class="page-header">
    <text class="header-action placeholder">‹</text>
    <text class="page-header-title">我的技能</text>
    <text class="header-action">···</text>
  </view>

  <view class="radar-card anim {{shown ? 'show' : ''}}">
    <view class="card-title">技术能力雷达图</view>
    <canvas canvas-id="skillsRadar" class="radar-canvas" disable-scroll="true"></canvas>
    <view class="radar-legend"><view class="legend-dot"></view><text>我的能力</text></view>
  </view>

  <view class="skill-section-title">技能列表</view>
  <view class="skill-group" wx:for="{{profile.skills}}" wx:key="group" wx:for-item="group">
    <view class="skill-group-title">{{group.group}}</view>
    <view class="skill-row" wx:for="{{group.items}}" wx:key="name" wx:for-item="skill">
      <view class="skill-row-top">
        <text class="skill-name">{{skill.name}}</text>
        <text class="skill-level">{{skill.level}}%</text>
      </view>
      <view class="skill-track"><view class="skill-fill" style="width:{{skill.level}}%;"></view></view>
    </view>
  </view>
  <tabbar active="skills" />
</view>
