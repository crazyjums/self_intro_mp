<view class="page">
  <view class="card skill-card anim {{shown ? 'show' : ''}}">
    <view class="skill-summary">
      <view class="skill-count">5</view>
      <view class="skill-count-label muted">技术领域</view>
    </view>
    <view class="skill-intro">
      后端正向高并发、云原生与工程效率方向持续深耕。
    </view>
  </view>

  <view class="skill-group anim {{shown ? 'show' : ''}}" style="animation-delay: .1s;"
    wx:for="{{profile.skills}}" wx:key="group" wx:for-item="group">
    <view class="skill-group-head">
      <text class="skill-group-title">{{group.group}}</text>
      <text class="skill-group-count muted">{{group.items.length}} 项</text>
    </view>
    <view class="card">
      <view class="bar-item" wx:for="{{group.items}}" wx:key="name" wx:for-item="skill">
        <view class="bar-top">
          <text class="bar-name">{{skill.name}}</text>
          <text class="bar-level muted">{{skill.level}}</text>
        </view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{shown ? skill.level : 0}}%;"></view>
        </view>
      </view>
    </view>
  </view>
</view>
