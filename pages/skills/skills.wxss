.skills-page { padding-top: 12rpx; }
.radar-card { position: relative; margin-top: 10rpx; padding: 28rpx 22rpx 22rpx; overflow: hidden; border: 1rpx solid rgba(116,255,188,.2); border-radius: 26rpx; background: radial-gradient(circle at 50% 32%, rgba(43,148,109,.18), rgba(7,28,29,.9) 68%); box-shadow: var(--shadow), inset 0 1rpx 0 rgba(255,255,255,.06); }
.card-title { font-size: 28rpx; font-weight: 700; }
.radar-canvas { display: block; width: 100%; height: 400rpx; margin-top: 8rpx; }
.radar-legend { display: flex; align-items: center; justify-content: flex-end; color: var(--ink-3); font-size: 20rpx; }
.legend-dot { width: 14rpx; height: 14rpx; margin-right: 8rpx; background: var(--accent); box-shadow: 0 0 12rpx rgba(67,245,154,.66); }
.skill-section-title { margin: 38rpx 4rpx 20rpx; padding-left: 14rpx; border-left: 6rpx solid var(--accent); color: var(--ink); font-size: 30rpx; font-weight: 700; }
.skill-group { margin-bottom: 22rpx; padding: 22rpx 20rpx 8rpx; border: 1rpx solid rgba(116,255,188,.14); border-radius: 22rpx; background: rgba(7,28,29,.7); }
.skill-group-title { margin-bottom: 18rpx; color: #73F6B2; font-size: 22rpx; font-weight: 700; }
.skill-row { margin-bottom: 18rpx; }
.skill-row-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.skill-name { font-size: 25rpx; }
.skill-level { color: var(--ink-3); font-size: 22rpx; }
.skill-track { height: 8rpx; overflow: hidden; border-radius: 999rpx; background: rgba(197,232,219,.12); }
.skill-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #1FCB78, #63F6B0); box-shadow: 0 0 12rpx rgba(67,245,154,.58); }
.anim { opacity: 0; }
.anim.show { animation: fadeUp .48s cubic-bezier(.22,1,.36,1) forwards; }
