.poster-page { min-height: 100vh; padding: 12rpx 24rpx 150rpx; background: #02090D; }
.poster-header { margin-bottom: 20rpx; }
.poster-frame { position: relative; width: 375px; height: 600px; margin: 0 auto; overflow: hidden; border-radius: 22rpx; box-shadow: 0 18rpx 60rpx rgba(0,0,0,.2); transform: scale(.92); transform-origin: top center; margin-bottom: -48rpx; }
canvas { display: block; width: 375px; height: 600px; }
.qr-overlay { position: absolute; left: 223px; top: 442px; width: 100px; height: 100px; border-radius: 4px; }
.poster-tip { color: var(--ink-3); font-size: 21rpx; text-align: center; }
.poster-actions { display: flex; gap: 18rpx; margin-top: 24rpx; }
.poster-actions .btn { flex: 1; height: 82rpx; font-size: 25rpx; }
.poster-actions button.btn { margin: 0; padding: 0; line-height: 82rpx; }
.poster-actions button.btn::after { border: none; }
.share-btn { margin: 0; padding: 0; line-height: 82rpx; }
