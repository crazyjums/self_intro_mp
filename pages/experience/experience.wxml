<view class="page growth-page">
  <view class="page-header">
    <text class="header-action">‹</text>
    <text class="page-header-title">我的技术成长</text>
    <text class="header-action">···</text>
  </view>
  <view class="growth-list">
    <view class="growth-row" wx:for="{{profile.growth}}" wx:key="year">
      <view class="growth-year">{{item.year}}</view>
      <view class="growth-node"><view class="growth-dot">{{index + 1}}</view><view class="growth-line" wx:if="{{index < profile.growth.length - 1}}"></view></view>
      <view class="growth-copy">
        <view class="growth-title">{{item.title}}</view>
        <view class="growth-detail">{{item.detail}}</view>
      </view>
    </view>
  </view>
  <tabbar active="profile" />
</view>
