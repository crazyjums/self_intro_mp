<view class="page">
  <view class="section-head">
    <text class="section-title">工作经历</text>
  </view>
  <view class="card">
    <view class="tl" wx:for="{{profile.workExperience}}" wx:key="period">
      <view class="tl-node">
        <view class="tl-dot work"></view>
        <view class="tl-line"></view>
      </view>
      <view class="tl-body">
        <view class="tl-period">{{item.period}}</view>
        <view class="tl-title">{{item.title}}</view>
        <view class="tl-org muted">{{item.org}}</view>
        <view class="tl-points">
          <view class="tl-point" wx:for="{{item.points}}" wx:for-item="p" wx:key="*this">{{p}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">教育经历</text>
  </view>
  <view class="card">
    <view class="tl" wx:for="{{profile.educationExperience}}" wx:key="period">
      <view class="tl-node">
        <view class="tl-dot edu"></view>
        <view class="tl-line"></view>
      </view>
      <view class="tl-body">
        <view class="tl-period">{{item.period}}</view>
        <view class="tl-title">{{item.title}}</view>
        <view class="tl-org muted">{{item.org}}</view>
        <view class="tl-points">
          <view class="tl-point" wx:for="{{item.points}}" wx:for-item="p" wx:key="*this">{{p}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
