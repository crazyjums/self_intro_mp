.readme-head {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 44rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
  margin-bottom: 8rpx;
}

.readme-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.readme-tech {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.readme-tech .tag {
  margin: 0 12rpx 12rpx 0;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
}

.readme-desc {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.doc {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 40rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}

.doc-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.doc-title::before {
  content: "# ";
}

.doc-body {
  font-size: 27rpx;
  color: var(--ink-2);
  line-height: 1.75;
}

.doc-list {
  margin-top: 4rpx;
}

.doc-item {
  position: relative;
  padding: 8rpx 0 8rpx 30rpx;
  font-size: 27rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.doc-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: var(--accent);
  transform: rotate(45deg);
}

/* architecture diagram */
.arch {
  margin-top: 28rpx;
  background: #0B0F0E;
  border-radius: var(--radius-sm);
  padding: 32rpx 28rpx;
}

.arch-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.arch-node {
  padding: 14rpx 28rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.gw { background: linear-gradient(135deg, #00ADD8, #00C0E0); }
.py { background: linear-gradient(135deg, #3776AB, #4B8BBE); }
.jk { background: linear-gradient(135deg, #D24939, #E05D4C); }
.k8s { background: linear-gradient(135deg, #326CE5, #5B8DEF); }
.rd { background: linear-gradient(135deg, #DC382D, #E8590C); }
.my { background: linear-gradient(135deg, #00758F, #00A4BD); }
.kf { background: linear-gradient(135deg, #262626, #434343); }

.arch-flow {
  text-align: center;
  color: #34D399;
  font-size: 20rpx;
  padding: 14rpx 0;
  letter-spacing: 2rpx;
}

/* results */
.result-grid {
  display: flex;
  flex-wrap: wrap;
}

.result-chip {
  margin: 0 16rpx 16rpx 0;
  padding: 18rpx 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent-dark);
  background: var(--accent-soft);
  border: 1rpx solid rgba(16, 185, 129, 0.25);
}

.anim {
  opacity: 0;
}

.anim.show {
  animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
